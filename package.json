{
  "name": "mustache-mart",
  "version": "0.2.0",
  "description": "An absurdly long, colorful, first-person supermarket shelf-stocking simulator.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "check": "node --check main.js && node --check src/game.js"
  },
  "dependencies": {
    "three": "0.160.0"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.mustachemart.game",
    "productName": "Mustache Mart",
    "files": [
      "main.js",
      "index.html",
      "src/**/*",
      "node_modules/three/build/three.module.js"
    ],
    "win": {
      "target": "dir"
    },
    "mac": {
      "target": "dir"
    },
    "linux": {
      "target": "dir"
    },
    "directories": {
      "output": "dist"
    }
  }
}
